config_version=5

[application]

config/name="Fair Bench Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[physics]

3d/physics_engine="Jolt Physics"
common/physics_jitter_fix=0.0
; Matched to the JoltPhysics.js world in web/shared/jolt-world.js: box convex radius 0.05
; (bench.gd sets shape margin 0.05; min(0.05, 0.2 * 0.5) = 0.05), JS default edge removal off,
; same contact budget (20480, also Godot's default). max_bodies raised for the larger rungs.
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=false
jolt_physics_3d/collisions/collision_margin_fraction=0.5
jolt_physics_3d/limits/max_bodies=20000
jolt_physics_3d/limits/max_contact_constraints=20480

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
